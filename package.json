{
  "name": "ashare-volpulse",
  "version": "0.1.0",
  "description": "Windows / macOS 桌面端 A 股盘中实时能量看板（紧凑悬浮窗 HUD + 可展开详情浮层 + 系统托盘）",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:replay": "node scripts/verify-replay.mjs",
    "package": "node scripts/package-app.mjs --win",
    "package:win": "node scripts/package-app.mjs --win",
    "package:mac": "node scripts/package-app.mjs --mac"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
